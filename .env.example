# Copy to .env and fill in. Names only here — never commit real values.

# ---------------------------------------------------------------------------
# Database — Supabase (Postgres). Required for /admin/leads and
# /admin/settings to read or write anything.
#
#   SUPABASE_URL         Dashboard > Project Settings > Data API > Project URL
#                        e.g. https://abcdefghijklmnop.supabase.co
#   SUPABASE_SECRET_KEY  Dashboard > Project Settings > API Keys >
#                        service_role (legacy) or the sb_secret_… key
#
# The secret key bypasses row-level security, which is the design: crm_leads
# and app_settings have RLS enabled with no policies, so this key is the only
# thing that can reach them. Server-side only — never prefix it NEXT_PUBLIC_.
#
# Setup, once:
#   1. Paste supabase/migrations/0001_crm_leads_and_settings.sql into the
#      Supabase SQL Editor and run it.
#   2. Fill in the two variables below.
#   3. npm run db:seed
#
# Leave both blank and the app still boots — the public site renders on
# DEFAULT_SETTINGS and the admin pages show the 46 sample leads behind a notice.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Not read by the app. Only needed for direct psql / connection-pooler access.
SUPABASE_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Plasmic — the visual editor behind every public page. Without these the
# public pages fall back to their coded versions in src/components/pages/.
# Dashboard > Project > Settings > API tokens.
# ---------------------------------------------------------------------------
PLASMIC_API_TOKEN=
PLASMIC_PROJECT_ID=

# ---------------------------------------------------------------------------
# Website chat assistant. /api/chat proxies to this n8n workflow; the
# integrations.n8nWebhookUrl setting overrides it when set, and a hardcoded
# fallback in src/lib/chat/webhook.ts covers neither being present.
# ---------------------------------------------------------------------------
N8N_CHAT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Optional. Pins the date the lead tracker treats as "today", so the seed
# data's relative numbers stay stable. Unset in production.
# ---------------------------------------------------------------------------
CRM_TODAY=
