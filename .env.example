# Copy to .env and fill in. Names only here — never commit real values.

# ---------------------------------------------------------------------------
# Database — Supabase (Postgres)
#
# Two clients, two different keys. Crossing them fails quietly rather than
# loudly, so the split is worth reading once:
#
#   src/lib/supabase/service.ts  — secret key, bypasses RLS, no session.
#                                  The lead book, settings, appointments, the
#                                  /admin tables, and the seeder.
#   src/lib/supabase/server.ts   — publishable key + the visitor's cookies.
#                                  Auth and the /admin route guard. Subject to
#                                  RLS.
#
# crm_leads and app_settings have RLS on with zero policies, so the secret key
# is the only thing that can read them at all. Hand those tables the publishable
# key and every query returns an empty array with no error at all.
#
# Setup, once:
#   1. Paste every file in supabase/migrations/ into the Supabase SQL Editor,
#      in numeric order, and run each one.
#   2. Fill in the four variables below (the URL goes in twice).
#   3. npm run db:seed
#   4. Create an admin user under Authentication > Users — /admin/* is behind
#      the route guard in src/proxy.ts and there is no sign-up flow.
#
# Leave the Supabase values blank and the public site still boots on
# DEFAULT_SETTINGS, but /admin is unreachable — the guard needs the auth client.
# ---------------------------------------------------------------------------

# Server-side only. NEVER prefix this key NEXT_PUBLIC_ — it would ship the
# RLS-bypassing credential to every visitor's browser.
# Dashboard > Project Settings > API Keys > service_role (or sb_secret_…)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Browser-safe and deliberately public. Same project URL as above, under the
# name the SSR auth client reads.
# Dashboard > Project Settings > API Keys > publishable (or anon)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Not read by the app. Only needed for direct psql / connection-pooler access.
SUPABASE_DB_PASSWORD=

# ---------------------------------------------------------------------------
# Plasmic — the visual editor behind every public page. Without these the
# public pages fall back to their coded versions in src/components/pages/.
# Dashboard > Project > Settings > API tokens.
# ---------------------------------------------------------------------------
PLASMIC_API_TOKEN=
PLASMIC_PROJECT_ID=

# ---------------------------------------------------------------------------
# Website chat assistant — DeepSeek.
#
# The assistant runs entirely in this app now (src/lib/chat/): the question is
# embedded locally, matched against the knowledge base in Postgres, and answered
# by DeepSeek. There is no n8n workflow any more.
#
# Setup, once:
#   1. Apply supabase/migrations/0004_chat_knowledge_base.sql in the SQL Editor.
#   2. Put the key below in place — https://platform.deepseek.com > API keys.
#   3. npm run kb:ingest   (first run downloads ~33 MB of embedding weights)
#
# Without the key the panel answers every question with "the assistant is
# unavailable"; without the migration and the ingest it answers, but only from
# the business details and admits it does not know anything else.
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=

# Optional. Defaults to deepseek-v4-flash; deepseek-v4-pro is the larger model.
DEEPSEEK_MODEL=

# Optional. Where the local embedding model's weights are cached. Defaults to
# .cache/transformers in the project directory.
#
# Questions are embedded in-process (src/lib/chat/embeddings.ts), so the server
# needs somewhere writable to keep ~33 MB of weights. A long-running Node host
# downloads them once. On a read-only serverless filesystem, point this at a
# writable temp directory (TRANSFORMERS_CACHE=/tmp/transformers) and accept the
# re-download on each cold start — or bake .cache/transformers into the image.
TRANSFORMERS_CACHE=

# ---------------------------------------------------------------------------
# Optional. Pins the date the lead tracker and the /admin dashboard treat as
# "today", so the seed data's relative numbers stay stable. It also decides
# which month the dashboard's New Leads count covers — the card names that
# month, so a stale pin is visible rather than silent. Unset in production.
# ---------------------------------------------------------------------------
CRM_TODAY=
