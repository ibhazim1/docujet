# --- Required ---
# DeepSeek API key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# --- Model (optional) ---
# deepseek-chat (default) or deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=700
LLM_MAX_HISTORY_TURNS=4

# --- Retrieval (optional) ---
RAG_KNOWLEDGE_BASE=chatbot/rag/documation-faq-rag.json
RAG_CHROMA_PATH=chatbot/rag/chroma
RAG_COLLECTION=documation_faq
# onnx (default, local all-MiniLM-L6-v2) or sentence-transformers
RAG_EMBEDDING_PROVIDER=onnx
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5
# Cosine similarity gate. Calibrated with: python -m chatbot.scripts.eval_retrieval
RAG_MIN_SIMILARITY=0.22
RAG_QUERY_EXPANSION=true

# --- Guardrails (optional) ---
# Entries flagged needs_client_confirmation are never served while this is false.
RAG_SERVE_UNVERIFIED=false
GUARDRAIL_MAX_QUESTION_CHARS=1000
# Second LLM pass that audits the answer against the context. Roughly doubles cost.
GUARDRAIL_GROUNDEDNESS_CHECK=false

# --- Pricing display (optional) ---
# USD per 1M tokens. Verify at https://api-docs.deepseek.com/quick_start/pricing
DEEPSEEK_PRICE_CACHE_HIT=0.028
DEEPSEEK_PRICE_CACHE_MISS=0.28
DEEPSEEK_PRICE_OUTPUT=0.42
USD_TO_MYR=4.45
